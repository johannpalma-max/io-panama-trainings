# ---- Autenticación del administrador ----
AUTH_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# ---- Base de datos (Upstash Redis - capa gratis) ----
# Crea una en https://upstash.com (Redis) y copia las credenciales REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Correo (Resend - capa gratis) ----
# API key de https://resend.com
RESEND_API_KEY=
# Remitente. Mientras no verifiques tu dominio, deja onboarding@resend.dev
EMAIL_FROM=EO Panamá <onboarding@resend.dev>
